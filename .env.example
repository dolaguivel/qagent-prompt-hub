# Copy to .env and adjust. Real environment variables win over this file.
# Never commit .env: it holds passwords.

PORT=3000

# --- Database -------------------------------------------------------------
# PostgreSQL (recommended for a shared server, required on Vercel).
# Neon / Vercel Marketplace sets DATABASE_URL for you.
# DATABASE_URL=postgres://user:password@host:5432/hub?sslmode=require
# DB_POOL_MAX=10

# Without DATABASE_URL the hub uses SQLite in this file:
DB_PATH=storage/hub.db
# WAL on a local disk; DELETE on network storage such as Azure App Service /home
SQLITE_JOURNAL_MODE=WAL

# Only for docker-compose.yml: password of the bundled PostgreSQL container
# DB_PASSWORD=change-me

# --- Accounts -------------------------------------------------------------
ALLOWED_DOMAIN=qualifacts.com
DEFAULT_PASSWORD=123456
ADMIN_USERNAME=admin
# Used only when the admin account is first created. Change it in the app afterwards.
ADMIN_PASSWORD=654321
REQUIRE_PASSWORD_CHANGE=false
SESSION_DAYS=30

# --- Server ---------------------------------------------------------------
REPORT_TIMEZONE=America/Chicago
# true behind a reverse proxy or load balancer (always on for Vercel)
TRUST_PROXY=false
COOKIE_SECURE=auto
