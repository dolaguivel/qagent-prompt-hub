{
  "name": "qagent-prompt-hub",
  "version": "2.5.0",
  "private": true,
  "description": "Shared library of QAgent prompts with accounts, ratings, favorites, a ticket comment generator and usage dashboards.",
  "main": "server/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "demo": "node --disable-warning=ExperimentalWarning server/demo.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/seed-demo.js",
    "build:local": "node tools/build-local.js",
    "db:check": "node --disable-warning=ExperimentalWarning tools/db-check.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "pg": "^8.16.0"
  }
}
